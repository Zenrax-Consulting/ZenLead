{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=ZenLeadE2E;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "zenlead-e2e",
    "Audience": "zenlead-e2e"
  },
  "Email": {
    "Provider": "Pickup",
    "PickupDirectory": "../.e2e/mail",
    "InboundDomain": "reply.example.test"
  },
  "Ai": {
    "Provider": "Fake"
  },
  "LeadSource": {
    "Provider": "Fake"
  },
  "Hangfire": {
    "Enabled": false
  },
  "Seed": {
    "SuperAdmin": false
  },
  "App": {
    "PublicBaseUrl": "https://localhost:52618"
  },
  "Sending": {
    "Mode": "Restricted",
    "RecipientAllowList": [ "example.test" ]
  },
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "RateLimits": {
    "AuthPermitLimit": 1000,
    "RegisterPermitLimit": 1000,
    "PickerPermitLimit": 1000,
    "ForgotPermitLimit": 1000,
    "UnsubscribePermitLimit": 1000,
    "ReplyPermitLimit": 1000
  }
}
